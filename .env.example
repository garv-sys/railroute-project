# RailRoute Environment Variables Example
# Copy this file to .env or .env.local and fill in values

# IRCTC / Railway Provider Key
IRCTC_API_KEY=your_irctc_api_key_here

# Database URL (SQLite default for local dev)
DATABASE_URL="file:./dev.db"

# Redis Cache URL (optional, for local rate limiting / caching)
REDIS_URL="redis://localhost:6379"

# Next.js App Public URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# AI & Maps API Keys (optional)
GEMINI_API_KEY="your_gemini_api_key_here"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
